# Server & URL
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN=""

# Render PostgreSQL Database (Required on Render)
# Create a NEW, SEPARATE PostgreSQL database on Render and set DATABASE_URL to its connection string.
# Use DATABASE_SSL="auto" (handles both Render Internal URLs and External *.render.com SSL URLs).
DATABASE_URL=""
DATABASE_SSL="auto"

# Authentication (JWT)
JWT_SECRET="replace-with-strong-random-64-char-secret"
JWT_EXPIRES_IN="7d"

# Bootstrap Admin Account (Set ADMIN_PASSWORD in Render Environment Variables)
ADMIN_FULL_NAME="Acadet Super Admin"
ADMIN_EMAIL="admin@acadetjamb.com"
ADMIN_USERNAME="acadetadmin"
ADMIN_PASSWORD=""

# Transactional Email (Resend)
RESEND_API_KEY=""
SMTP_FROM_EMAIL="Acadet JAMB CBT <no-reply@acadetjamb.com>"

# S3-Compatible Object Storage for Study Materials (Optional; falls back to local ./uploads)
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_PUBLIC_URL=""
UPLOAD_DIR="./uploads"
